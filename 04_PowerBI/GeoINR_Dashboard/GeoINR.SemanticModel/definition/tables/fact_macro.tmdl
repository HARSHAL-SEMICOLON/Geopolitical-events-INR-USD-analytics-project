		sourceColumn: mom_change

	column series_version
		dataType: string
		lineageTag: 144f39ab-ef87-54a2-a6bb-661634072229
		summarizeBy: none
		sourceColumn: series_version

	partition fact_macro = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fact_macro.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), (c) => {c, each if _ = "" then null else _})),
				    Typed = Table.TransformColumnTypes(Nulls, {{"date_key", Int64.Type}, {"series_id", type text}, {"period_start", type date}, {"frequency", type text}, {"value", type number}, {"yoy_pct", type number}, {"mom_change", type number}, {"series_version", type text}}, "en-US")
				in
				    Typed


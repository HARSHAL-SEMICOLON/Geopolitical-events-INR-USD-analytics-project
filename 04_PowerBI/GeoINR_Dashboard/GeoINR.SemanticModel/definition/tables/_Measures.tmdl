	measure 'Event Marker (USDINR)' =
			VAR _d = SELECTEDVALUE ( dim_date[date_key] )
			VAR _isEvent =
			    CALCULATE ( COUNTROWS ( fact_event_anchor ), fact_event_anchor[t0_date_key] = _d, fact_event_anchor[covered] = 1 )
			RETURN IF ( _isEvent > 0, [USDINR Rate] )
		formatString: 0.00
		displayFolder: 2 Timeline
		lineageTag: 613ee8b8-f0db-5ed4-a56d-9fb7d316e91f

	measure 'Event t0 Date' =
			VAR _b = SELECTEDVALUE ( dim_fx_basis[basis], "RBI" )
			RETURN CALCULATE ( MIN ( fact_event_anchor[t0_date] ), fact_event_anchor[basis] = _b )
		formatString: yyyy-mm-dd
		displayFolder: 2 Timeline
		lineageTag: 37656b31-0f8c-5ec9-b8d5-6e277d686720

	measure 'Event Name on Date' =
			VAR _d = SELECTEDVALUE ( dim_date[date_key] )
			RETURN
			    CONCATENATEX (
			        FILTER ( fact_event_anchor, fact_event_anchor[t0_date_key] = _d ),
			        RELATED ( dim_event[event_label] ), " | " )
		displayFolder: 2 Timeline
		lineageTag: 25fa7b94-f258-5920-8c5a-d8d347f86db2

	measure 'Events in Selection' = DISTINCTCOUNT ( dim_event[event_id] )

	measure 'Policy Changes in Window' =
			IF ( HASONEVALUE ( dim_window[window_id] ),
			    VAR _t = SELECTCOLUMNS ( fact_event_window_context, "@txt",
			        TRIM ( IF ( NOT ISBLANK ( fact_event_window_context[rbi_repo_changes] ), "RBI " & fact_event_window_context[rbi_repo_changes] )
			            & IF ( NOT ISBLANK ( fact_event_window_context[fomc_target_changes] ), "  Fed " & fact_event_window_context[fomc_target_changes] ) ) )
			    RETURN CONCATENATEX ( FILTER ( DISTINCT ( _t ), [@txt] <> "" ), [@txt], "; " ) )
		displayFolder: 3 Event windows
		lineageTag: c2fd4af6-48cf-5c16-b25a-fc518a3b1f18

	measure 'Overlapping Events' = IF ( HASONEVALUE ( dim_window[window_id] ), CONCATENATEX ( FILTER ( DISTINCT ( SELECTCOLUMNS ( fact_event_window_context, "@o", fact_event_window_context[overlapping_events] ) ), [@o] <> "" ), [@o], ", " ) )
		displayFolder: 3 Event windows

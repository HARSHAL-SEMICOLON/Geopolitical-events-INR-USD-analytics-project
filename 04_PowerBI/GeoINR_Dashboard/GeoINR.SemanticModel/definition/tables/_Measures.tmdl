	measure 'Pct Days Exact Match' = DIVIDE ( SUM ( dq_alignment[exact] ), SUM ( dq_alignment[days] ) )
		formatString: 0.0%
		displayFolder: 7 Data quality
		lineageTag: 960476f2-b7a5-5c71-8ca9-6fbe93648f6b

	measure 'Pct Days Carried Forward' = DIVIDE ( SUM ( dq_alignment[carried] ), SUM ( dq_alignment[days] ) )
		formatString: 0.0%
		displayFolder: 7 Data quality
		lineageTag: 96657625-cd30-5852-a30c-7d72244c6300

	measure 'Pct Days Missing' = DIVIDE ( SUM ( dq_alignment[missing] ), SUM ( dq_alignment[days] ) )
		formatString: 0.0%
		displayFolder: 7 Data quality
		lineageTag: ba1bf382-5bbd-544a-be79-21e4e04b6d7e

	measure 'FRED minus RBI (%)' = AVERAGE ( dq_fx_crosscheck[diff_pct] ) / 100
		formatString: 0.00%
		displayFolder: 7 Data quality
		lineageTag: 78fac2c2-3ea1-50ff-89df-ef8589a8ba5c

	measure 'Mean Abs FRED-RBI Gap (%)' = AVERAGEX ( dq_fx_crosscheck, ABS ( dq_fx_crosscheck[diff_pct] ) ) / 100
		formatString: 0.00%
		displayFolder: 7 Data quality
		lineageTag: d763b72f-e011-56b7-89db-0fcf3a063b4e

	measure 'Days > 0.5% Gap' = SUM ( dq_fx_crosscheck[large_gap_flag] )
		formatString: 0
		displayFolder: 7 Data quality
		lineageTag: 435b0fbb-4e4e-5e73-ac2e-aa514416015a

	measure 'Series Not OK' = CALCULATE ( COUNTROWS ( dq_series_coverage ), dq_series_coverage[status] <> "OK" )
		formatString: 0
		displayFolder: 7 Data quality
		lineageTag: 6feb0302-6607-5515-9896-0fca08fcda89

	measure 'Causality Caption' = "Association, not causation. Confounders: policy rates, oil, US dollar, risk sentiment, flows, RBI action."
		displayFolder: 0 Captions
		lineageTag: 02f8ccab-1ff3-528f-b110-9ea2867d18af

	measure 'Basis Caption' =
			VAR _b = SELECTEDVALUE ( dim_fx_basis[basis], "RBI" )
			RETURN IF ( _b = "RBI",
			    "Basis: RBI/FBIL reference rate (~13:30 IST), data to 29-Sep-2026",
			    "Basis: Fed H.10 noon New York rate (cross-check), data to 25-Sep-2026" )
		displayFolder: 0 Captions
		lineageTag: e9b684a1-829e-5d23-8316-1ce7ca77888d

	measure 'Window Caption' =
			IF ( HASONEVALUE ( dim_window[window_id] ),
			    "Window: " & SELECTEDVALUE ( dim_window[window_label] ) & " (" & SELECTEDVALUE ( dim_window[definition] ) & ")",
			    "Select ONE window in the slicer to populate the cards, scatter and context table" )
		displayFolder: 0 Captions
		lineageTag: ce5dce4a-21e0-5976-a8ca-74c898660c22

	column _
		dataType: string
		isHidden
		lineageTag: 9ceace78-5bc1-52f3-9016-bf6331c8c49f

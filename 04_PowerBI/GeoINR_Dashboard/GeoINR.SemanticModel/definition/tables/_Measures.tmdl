	measure 'Repo Rate (latest)' =
			VAR _last = MAX ( fact_daily_aligned[date_key] )
			RETURN CALCULATE ( AVERAGE ( fact_daily_aligned[in_repo] ), fact_daily_aligned[date_key] = _last )
		formatString: 0.00
		displayFolder: 1 Overview
		lineageTag: f131a1f6-cd03-5157-9635-679bcf954767

	measure 'Fed Funds Upper (latest)' =
			VAR _last = MAX ( fact_daily_aligned[date_key] )
			RETURN CALCULATE ( AVERAGE ( fact_daily_aligned[ffr_upper] ), fact_daily_aligned[date_key] = _last )

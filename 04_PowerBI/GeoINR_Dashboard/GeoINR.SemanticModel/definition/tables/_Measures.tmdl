table _Measures
	lineageTag: 82a5c9e5-2730-582e-a86c-08fc3de6b639

	measure 'USDINR Rate' = AVERAGE ( fact_daily_aligned[usdinr] )
		formatString: 0.0000
		displayFolder: 1 Overview
		lineageTag: e157dbea-cc19-5e73-9426-88846966aaee

	measure 'USDINR Latest' =
			VAR _last = CALCULATE ( MAX ( fact_daily_aligned[date_key] ), NOT ISBLANK ( fact_daily_aligned[usdinr] ) )
			RETURN CALCULATE ( [USDINR Rate], fact_daily_aligned[date_key] = _last )
		formatString: 0.00
		displayFolder: 1 Overview
		lineageTag: 1da3dd74-6265-51c2-be83-5754db1dfc4c

	measure 'USDINR First' =
			VAR _first = CALCULATE ( MIN ( fact_daily_aligned[date_key] ), NOT ISBLANK ( fact_daily_aligned[usdinr] ) )
			RETURN CALCULATE ( [USDINR Rate], fact_daily_aligned[date_key] = _first )
		formatString: 0.00
		displayFolder: 1 Overview
		lineageTag: 08233c2b-d54d-5d83-b2b0-b1930281728f

	measure 'USDINR % Change (period)' = DIVIDE ( [USDINR Latest], [USDINR First] ) - 1
		formatString: 0.00%
		displayFolder: 1 Overview
		lineageTag: 89c8e9ae-9f37-5437-b8b6-47ed9b39de17

	measure 'INR % Change (period)' = DIVIDE ( [USDINR First], [USDINR Latest] ) - 1
		formatString: 0.00%
		displayFolder: 1 Overview
		lineageTag: a0860296-0719-50c2-bd37-4db941347466

	measure 'USDINR Vol 20d (ann. %)' = AVERAGE ( fact_daily_aligned[usdinr_vol20] ) / 100
		formatString: 0.00%

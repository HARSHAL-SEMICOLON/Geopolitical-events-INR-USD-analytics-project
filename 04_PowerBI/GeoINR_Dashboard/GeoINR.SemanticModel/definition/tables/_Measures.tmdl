	measure 'Corr USDINR~Brent (period)' =
			VAR _t =
			    FILTER ( fact_daily_aligned,
			        NOT ISBLANK ( fact_daily_aligned[usdinr_logret] ) && NOT ISBLANK ( fact_daily_aligned[brent_logret] ) )
			VAR _n = COUNTROWS ( _t )
			VAR _mx = AVERAGEX ( _t, fact_daily_aligned[usdinr_logret] )
			VAR _my = AVERAGEX ( _t, fact_daily_aligned[brent_logret] )
			VAR _cov = SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) * ( fact_daily_aligned[brent_logret] - _my ) )
			VAR _sx = SQRT ( SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) ^ 2 ) )
			VAR _sy = SQRT ( SUMX ( _t, ( fact_daily_aligned[brent_logret] - _my ) ^ 2 ) )
			RETURN IF ( _n >= 40, DIVIDE ( _cov, _sx * _sy ) )
		formatString: 0.00
		displayFolder: 4-5 Cross-asset
		lineageTag: a159e1fc-9972-5079-90fe-350d6777dc4c

	measure 'Corr USDINR~Gold (period)' =
			VAR _t =
			    FILTER ( fact_daily_aligned,
			        NOT ISBLANK ( fact_daily_aligned[usdinr_logret] ) && NOT ISBLANK ( fact_daily_aligned[gold_logret] ) )
			VAR _n = COUNTROWS ( _t )
			VAR _mx = AVERAGEX ( _t, fact_daily_aligned[usdinr_logret] )
			VAR _my = AVERAGEX ( _t, fact_daily_aligned[gold_logret] )
			VAR _cov = SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) * ( fact_daily_aligned[gold_logret] - _my ) )
			VAR _sx = SQRT ( SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) ^ 2 ) )
			VAR _sy = SQRT ( SUMX ( _t, ( fact_daily_aligned[gold_logret] - _my ) ^ 2 ) )
			RETURN IF ( _n >= 40, DIVIDE ( _cov, _sx * _sy ) )
		formatString: 0.00
		displayFolder: 4-5 Cross-asset
		lineageTag: 07bb35cd-ff53-5e46-b359-9160b3290cba

	measure 'Corr USDINR~Nifty (period)' =
			VAR _t =
			    FILTER ( fact_daily_aligned,
			        NOT ISBLANK ( fact_daily_aligned[usdinr_logret] ) && NOT ISBLANK ( fact_daily_aligned[nifty_logret] ) )
			VAR _n = COUNTROWS ( _t )
			VAR _mx = AVERAGEX ( _t, fact_daily_aligned[usdinr_logret] )
			VAR _my = AVERAGEX ( _t, fact_daily_aligned[nifty_logret] )
			VAR _cov = SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) * ( fact_daily_aligned[nifty_logret] - _my ) )
			VAR _sx = SQRT ( SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) ^ 2 ) )
			VAR _sy = SQRT ( SUMX ( _t, ( fact_daily_aligned[nifty_logret] - _my ) ^ 2 ) )
			RETURN IF ( _n >= 40, DIVIDE ( _cov, _sx * _sy ) )
		formatString: 0.00
		displayFolder: 4-5 Cross-asset
		lineageTag: e0db9e51-3ca2-52a0-a622-3c61af36048f


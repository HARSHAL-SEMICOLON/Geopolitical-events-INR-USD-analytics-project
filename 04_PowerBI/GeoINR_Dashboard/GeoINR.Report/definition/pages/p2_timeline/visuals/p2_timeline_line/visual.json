                  "Property": "date"
                }
              },
              "queryRef": "dim_date.date",
              "nativeQueryRef": "date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "USDINR Rate"
                }
              },
              "queryRef": "_Measures.USDINR Rate",
              "nativeQueryRef": "USDINR Rate"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Event Marker (USDINR)"
                }
              },
              "queryRef": "_Measures.Event Marker (USDINR)",
              "nativeQueryRef": "Event Marker (USDINR)"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Event Name on Date"
                }
              },
              "queryRef": "_Measures.Event Name on Date",
              "nativeQueryRef": "Event Name on Date"
            }
          ]
        }
      }
    },
    "objects": {
      "lineStyles": [
        {
          "properties": {
            "showMarker": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "strokeWidth": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            },
            "markerSize": {
              "expr": {
                "Literal": {
                  "Value": "7D"
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Event Marker (USDINR)"
          }
        },
        {
          "properties": {
            "showMarker": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.USDINR Rate"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'USD/INR with event dates (dots = t0, first trading day after the news)'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  }
}
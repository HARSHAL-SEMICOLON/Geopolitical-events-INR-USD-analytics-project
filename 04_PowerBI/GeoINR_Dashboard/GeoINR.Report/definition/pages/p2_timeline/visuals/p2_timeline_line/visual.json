{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "p2_timeline_line",
  "position": {
    "x": 16,
    "y": 148,
    "z": 700,
    "height": 250,
    "width": 1248,
    "tabOrder": 700
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {

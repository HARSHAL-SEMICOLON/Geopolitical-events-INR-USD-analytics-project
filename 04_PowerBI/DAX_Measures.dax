// Generated by 04_PowerBI/generate_powerbi_project.py - the same measures are inside GeoINR.SemanticModel.
// Sign convention: USD/INR change > 0  =>  rupee WEAKENED.


// ---------- 1 Overview ----------
USDINR Rate =
AVERAGE ( fact_daily_aligned[usdinr] )
// format: 0.0000

USDINR Latest =
VAR _last = CALCULATE ( MAX ( fact_daily_aligned[date_key] ), NOT ISBLANK ( fact_daily_aligned[usdinr] ) )
RETURN CALCULATE ( [USDINR Rate], fact_daily_aligned[date_key] = _last )
// format: 0.00

USDINR First =
VAR _first = CALCULATE ( MIN ( fact_daily_aligned[date_key] ), NOT ISBLANK ( fact_daily_aligned[usdinr] ) )
RETURN CALCULATE ( [USDINR Rate], fact_daily_aligned[date_key] = _first )
// format: 0.00

USDINR % Change (period) =
DIVIDE ( [USDINR Latest], [USDINR First] ) - 1
// format: 0.00%

INR % Change (period) =
DIVIDE ( [USDINR First], [USDINR Latest] ) - 1
// format: 0.00%

USDINR Vol 20d (ann. %) =
AVERAGE ( fact_daily_aligned[usdinr_vol20] ) / 100
// format: 0.00%

Repo Rate (latest) =
VAR _last = MAX ( fact_daily_aligned[date_key] )
RETURN CALCULATE ( AVERAGE ( fact_daily_aligned[in_repo] ), fact_daily_aligned[date_key] = _last )
// format: 0.00

Fed Funds Upper (latest) =
VAR _last = MAX ( fact_daily_aligned[date_key] )
RETURN CALCULATE ( AVERAGE ( fact_daily_aligned[ffr_upper] ), fact_daily_aligned[date_key] = _last )
// format: 0.00

Rate Differential IN-US (pp) =
[Repo Rate (latest)] - [Fed Funds Upper (latest)]
// format: 0.00

India CPI YoY % =
CALCULATE ( AVERAGE ( fact_macro[yoy_pct] ), dim_series[series_id] = "IN_CPI_MOSPI" ) / 100
// format: 0.00%

US CPI YoY % =
CALCULATE ( AVERAGE ( fact_macro[yoy_pct] ), dim_series[series_id] = "US_CPI" ) / 100
// format: 0.00%

RBI Repo Rate % =
CALCULATE ( AVERAGE ( fact_macro[value] ), dim_series[series_id] = "IN_REPO" ) / 100
// format: 0.00%

Fed Funds Upper % =
CALCULATE ( AVERAGE ( fact_macro[value] ), dim_series[series_id] = "FFR_UPPER" ) / 100
// format: 0.00%

RBI Net FX (USD bn, monthly) =
CALCULATE ( SUM ( fact_macro[value] ), dim_series[series_id] = "IN_RBI_FX_NET" ) / 1000
// format: 0.0


// ---------- 2 Timeline ----------
Event Marker (USDINR) =
VAR _d = SELECTEDVALUE ( dim_date[date_key] )
VAR _isEvent =
    CALCULATE ( COUNTROWS ( fact_event_anchor ), fact_event_anchor[t0_date_key] = _d, fact_event_anchor[covered] = 1 )
RETURN IF ( _isEvent > 0, [USDINR Rate] )
// format: 0.00

Event Name on Date =
VAR _d = SELECTEDVALUE ( dim_date[date_key] )
RETURN
    CONCATENATEX (
        FILTER ( fact_event_anchor, fact_event_anchor[t0_date_key] = _d ),
        RELATED ( dim_event[event_label] ), " | " )


Events in Selection =
DISTINCTCOUNT ( dim_event[event_id] )
// format: 0


// ---------- 3 Event windows ----------
Window Change =
CALCULATE ( AVERAGE ( fact_event_window[change] ),
    fact_event_window[status] IN { "complete", "partial" } )
// format: 0.00

Window Change % (price series) =
IF ( SELECTEDVALUE ( dim_analysis_series[change_unit] ) = "%", [Window Change] / 100 )
// format: 0.00%

USDINR Window Change % (matrix) =
CALCULATE ( AVERAGE ( fact_event_window[change] ),
    dim_analysis_series[series_id] = "USDINR",
    fact_event_window[status] IN { "complete", "partial" } ) / 100
// format: 0.00%

USDINR Window Change % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[change] ),
        dim_analysis_series[series_id] = "USDINR",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

INR Window Change % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[inr_pct_change] ),
        dim_analysis_series[series_id] = "USDINR",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

USDINR minus Broad USD % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[usdinr_minus_dxy_pp] ),
        dim_analysis_series[series_id] = "USDINR",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

Median USDINR Window Change % =
MEDIANX ( VALUES ( dim_event[event_id] ), [USDINR Window Change %] )
// format: 0.00%

Events with INR Weaker =
COUNTROWS ( FILTER ( VALUES ( dim_event[event_id] ), [USDINR Window Change %] > 0 ) )
// format: 0

Events Measured =
COUNTROWS ( FILTER ( VALUES ( dim_event[event_id] ), NOT ISBLANK ( [USDINR Window Change %] ) ) )
// format: 0

Share of Events INR Weaker =
DIVIDE ( [Events with INR Weaker], [Events Measured] )
// format: 0%

USDINR Baseline Percentile =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[percentile] ),
        dim_analysis_series[series_id] = "USDINR", fact_event_window[status] = "complete" ) )
// format: 0.0

USDINR Baseline Z =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[z_score] ),
        dim_analysis_series[series_id] = "USDINR", fact_event_window[status] = "complete" ) )
// format: 0.00

Window Status =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( SELECTEDVALUE ( fact_event_window[status], "mixed" ), dim_analysis_series[series_id] = "USDINR" ) )


Window Start Date =
IF ( HASONEVALUE ( dim_window[window_id] ), CALCULATE ( MIN ( fact_event_window[start_date] ), dim_analysis_series[series_id] = "USDINR" ) )
// format: yyyy-mm-dd

Window End Date =
IF ( HASONEVALUE ( dim_window[window_id] ), CALCULATE ( MAX ( fact_event_window[end_date] ), dim_analysis_series[series_id] = "USDINR" ) )
// format: yyyy-mm-dd

Policy Changes in Window =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CONCATENATEX ( fact_event_window_context,
        TRIM ( fact_event_window_context[rbi_repo_changes] & " " & fact_event_window_context[fomc_target_changes] ), "; " ) )


Overlapping Events =
IF ( HASONEVALUE ( dim_window[window_id] ), CONCATENATEX ( fact_event_window_context, fact_event_window_context[overlapping_events], ", " ) )


RBI Net FX in Window (USD bn) =
IF ( HASONEVALUE ( dim_window[window_id] ), DIVIDE ( SUM ( fact_event_window_context[rbi_net_fx_usd_mn] ), 1000 ) )
// format: 0.0

USDINR Path (t-1 = 100) =
CALCULATE ( AVERAGE ( fact_event_path[indexed_value] ), dim_analysis_series[series_id] = "USDINR" )
// format: 0.00


// ---------- 4-5 Cross-asset ----------
Brent Window Change % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[change] ),
        dim_analysis_series[series_id] = "BRENT",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

Gold Window Change % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[change] ),
        dim_analysis_series[series_id] = "GOLD_USD",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

Nifty Window Change % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[change] ),
        dim_analysis_series[series_id] = "NIFTY50",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

Broad USD Window Change % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[change] ),
        dim_analysis_series[series_id] = "DXY_BROAD",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

VIX Window Change % =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[change] ),
        dim_analysis_series[series_id] = "VIX",
        fact_event_window[status] IN { "complete", "partial" } ) / 100 )
// format: 0.00%

Brent Path (t-1 = 100) =
CALCULATE ( AVERAGE ( fact_event_path[indexed_value] ), dim_analysis_series[series_id] = "BRENT" )
// format: 0.00

Gold Path (t-1 = 100) =
CALCULATE ( AVERAGE ( fact_event_path[indexed_value] ), dim_analysis_series[series_id] = "GOLD_USD" )
// format: 0.00

Nifty Path (t-1 = 100) =
CALCULATE ( AVERAGE ( fact_event_path[indexed_value] ), dim_analysis_series[series_id] = "NIFTY50" )
// format: 0.00

Brent (USD/bbl) =
AVERAGE ( fact_daily_aligned[brent] )
// format: 0.00

Gold (USD/oz) =
AVERAGE ( fact_daily_aligned[gold_usd] )
// format: #,0

Nifty 50 =
AVERAGE ( fact_daily_aligned[nifty50] )
// format: #,0

Broad USD Index =
AVERAGE ( fact_daily_aligned[dxy_broad] )
// format: 0.00

Corr USDINR~Brent (period) =
VAR _t =
    FILTER ( fact_daily_aligned,
        NOT ISBLANK ( fact_daily_aligned[usdinr_logret] ) && NOT ISBLANK ( fact_daily_aligned[brent_logret] ) )
VAR _n = COUNTROWS ( _t )
VAR _mx = AVERAGEX ( _t, fact_daily_aligned[usdinr_logret] )
VAR _my = AVERAGEX ( _t, fact_daily_aligned[brent_logret] )
VAR _cov = SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) * ( fact_daily_aligned[brent_logret] - _my ) )
VAR _sx = SQRT ( SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) ^ 2 ) )
VAR _sy = SQRT ( SUMX ( _t, ( fact_daily_aligned[brent_logret] - _my ) ^ 2 ) )
RETURN IF ( _n >= 40, DIVIDE ( _cov, _sx * _sy ) )
// format: 0.00

Corr USDINR~Gold (period) =
VAR _t =
    FILTER ( fact_daily_aligned,
        NOT ISBLANK ( fact_daily_aligned[usdinr_logret] ) && NOT ISBLANK ( fact_daily_aligned[gold_logret] ) )
VAR _n = COUNTROWS ( _t )
VAR _mx = AVERAGEX ( _t, fact_daily_aligned[usdinr_logret] )
VAR _my = AVERAGEX ( _t, fact_daily_aligned[gold_logret] )
VAR _cov = SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) * ( fact_daily_aligned[gold_logret] - _my ) )
VAR _sx = SQRT ( SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) ^ 2 ) )
VAR _sy = SQRT ( SUMX ( _t, ( fact_daily_aligned[gold_logret] - _my ) ^ 2 ) )
RETURN IF ( _n >= 40, DIVIDE ( _cov, _sx * _sy ) )
// format: 0.00

Corr USDINR~Nifty (period) =
VAR _t =
    FILTER ( fact_daily_aligned,
        NOT ISBLANK ( fact_daily_aligned[usdinr_logret] ) && NOT ISBLANK ( fact_daily_aligned[nifty_logret] ) )
VAR _n = COUNTROWS ( _t )
VAR _mx = AVERAGEX ( _t, fact_daily_aligned[usdinr_logret] )
VAR _my = AVERAGEX ( _t, fact_daily_aligned[nifty_logret] )
VAR _cov = SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) * ( fact_daily_aligned[nifty_logret] - _my ) )
VAR _sx = SQRT ( SUMX ( _t, ( fact_daily_aligned[usdinr_logret] - _mx ) ^ 2 ) )
VAR _sy = SQRT ( SUMX ( _t, ( fact_daily_aligned[nifty_logret] - _my ) ^ 2 ) )
RETURN IF ( _n >= 40, DIVIDE ( _cov, _sx * _sy ) )
// format: 0.00


// ---------- 6 Volatility & correlation ----------
Brent Vol 20d (ann. %) =
AVERAGE ( fact_daily_aligned[brent_vol20] ) / 100
// format: 0.00%

Gold Vol 20d (ann. %) =
AVERAGE ( fact_daily_aligned[gold_vol20] ) / 100
// format: 0.00%

Rolling Corr 60d Brent =
AVERAGE ( fact_daily_aligned[corr60_brent] )
// format: 0.00

Rolling Corr 60d Gold =
AVERAGE ( fact_daily_aligned[corr60_gold] )
// format: 0.00

Rolling Corr 60d Broad USD =
AVERAGE ( fact_daily_aligned[corr60_dxy] )
// format: 0.00

Rolling Corr 60d VIX =
AVERAGE ( fact_daily_aligned[corr60_vix] )
// format: 0.00

Rolling Corr 60d Nifty =
AVERAGE ( fact_daily_aligned[corr60_nifty] )
// format: 0.00

USDINR Window Vol (ann. %) =
IF ( HASONEVALUE ( dim_window[window_id] ),
    CALCULATE ( AVERAGE ( fact_event_window[window_vol_ann_pct] ),
        dim_analysis_series[series_id] = "USDINR", fact_event_window[status] = "complete" ) / 100 )
// format: 0.00%

Window Corr =
IF ( HASONEVALUE ( dim_window[window_id] ), AVERAGE ( fact_event_window_corr[corr] ) )
// format: 0.00

Window Corr n =
IF ( HASONEVALUE ( dim_window[window_id] ), SUM ( fact_event_window_corr[n_obs] ) )
// format: 0

Noise Band (±) =
VAR _n = [Window Corr n]
RETURN IF ( _n > 3, 1.96 / SQRT ( _n - 1 ) )
// format: 0.00


// ---------- 7 Data quality ----------
DQ Issues =
COUNTROWS ( dq_issues )
// format: 0

DQ Warnings or Errors =
CALCULATE ( COUNTROWS ( dq_issues ), dq_issues[severity] IN { "warning", "error" } )
// format: 0

Pct Days Exact Match =
DIVIDE ( SUM ( dq_alignment[exact] ), SUM ( dq_alignment[days] ) )
// format: 0.0%

Pct Days Carried Forward =
DIVIDE ( SUM ( dq_alignment[carried] ), SUM ( dq_alignment[days] ) )
// format: 0.0%

Pct Days Missing =
DIVIDE ( SUM ( dq_alignment[missing] ), SUM ( dq_alignment[days] ) )
// format: 0.0%

FRED minus RBI (%) =
AVERAGE ( dq_fx_crosscheck[diff_pct] ) / 100
// format: 0.00%

Mean Abs FRED-RBI Gap (%) =
AVERAGEX ( dq_fx_crosscheck, ABS ( dq_fx_crosscheck[diff_pct] ) ) / 100
// format: 0.00%

Days > 0.5% Gap =
SUM ( dq_fx_crosscheck[large_gap_flag] )
// format: 0

Series Not OK =
CALCULATE ( COUNTROWS ( dq_series_coverage ), dq_series_coverage[status] <> "OK" )
// format: 0


// ---------- 0 Captions ----------
Causality Caption =
"Temporal association only - these windows show what markets did around an event date, not that the event caused the move. " &
"Confounders: monetary policy, oil, global risk sentiment, US-dollar strength, domestic conditions, trade & capital flows, RBI intervention."


Basis Caption =
VAR _b = SELECTEDVALUE ( dim_fx_basis[basis], "RBI" )
RETURN IF ( _b = "RBI",
    "USD/INR basis: RBI/FBIL reference rate (~13:30 IST), data to 29-Sep-2026",
    "USD/INR basis: Fed H.10 noon New York rate (cross-check), data to 25-Sep-2026" )


Window Caption =
IF ( HASONEVALUE ( dim_window[window_id] ),
    "Window: " & SELECTEDVALUE ( dim_window[window_label] ) & " (" & SELECTEDVALUE ( dim_window[definition] ) & ")",
    "Select ONE window in the slicer to populate the cards, scatter and context table" )

